# Copy this file to `.env` and adjust for your machine. `.env` is git-ignored.
# Every value is optional -- the defaults below are used when a key is missing.
# Put any future API keys / secrets in `.env` only, never in code.

# Device for the YOLO table detector: cpu | cuda | cuda:0
DEVICE=cpu
# Device for the card classifier CNN
CARD_DEVICE=cpu

# Model weights (paths relative to the project root)
MODEL_TABLE_PATH=vision/models/table_detector_v1.pt
MODEL_CARD_PATH=vision/models/tiny_corner_net_best_cardv4.pt

# Confidence thresholds (0..1)
TABLE_CONF_THRES=0.7
CARD_CONF_THRES=0.6

# Screen capture frame rate
CAPTURE_FPS=30

# Output folder for tools/capture_card_rois.py
CAPTURED_CARDS_DIR=data/captured_cards
